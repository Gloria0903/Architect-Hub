# ── Database (required) ──────────────────────────────────────────────
# Local dev / single instance: both can point at the same local Postgres.
#
# Production against Supabase with more than one app instance: DATABASE_URL
# should be the POOLED connection (port 6543, "Transaction" mode in the
# Supabase dashboard's connection string picker) -- what the app queries
# through at runtime. DIRECT_URL should be the DIRECT connection (port
# 5432) -- used only when running `prisma migrate`. See
# docs/SCALING_AND_RELIABILITY.md for why these need to be different.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/architect_hub"
DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/architect_hub"

# ── Auth.js (required) ───────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Used in emails / absolute links generated server-side (invites, resets).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

NODE_ENV="development"

# ── AWS S3 (optional — falls back to local disk storage if unset) ─────
# See docs/INFRASTRUCTURE_SETUP.md for bucket + IAM setup.
AWS_REGION=""
AWS_S3_BUCKET=""
# Omit the two below entirely if deploying with an IAM role instead of keys.
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# ── Redis (optional — email/reminders silently no-op if unset) ────────
# Upstash TCP connection string (rediss://...), not the REST URL.
# See docs/INFRASTRUCTURE_SETUP.md.
REDIS_URL=""

# ── Resend (optional — required only for actual email delivery) ───────
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Architect Hub <notifications@yourdomain.com>"

# ── Cron secret (required only if using /api/cron/reminders) ──────────
# Needed on hosting that can't run a persistent worker process (e.g.
# shared hosting) -- an external cron service hits this URL on a
# schedule instead. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# See docs/DEPLOYMENT.md, "Shared hosting" section.
CRON_SECRET=""
