# ─── Database ─────────────────────────────────────────────────────────────────
# Local PostgreSQL (replace YOUR_PASSWORD with your postgres password)
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/architect_hub"

# ─── Auth.js ──────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="your-secret-here-generate-a-random-32-byte-hex-string"

# ─── App URL ──────────────────────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"

# ─── Optional: File storage (Phase E) ─────────────────────────────────────────
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# AWS_REGION="af-south-1"
# AWS_S3_BUCKET="architect-hub-files"
