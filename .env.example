# ── Database (required) ──────────────────────────────────────────────
# This app uses Neon's serverless driver adapter (src/lib/prisma.ts) --
# the app queries the database over WSS (port 443), not a raw Postgres
# TCP connection. This is what makes it work on hosting that blocks
# outbound Postgres ports entirely (5432/6543), like HostPinnacle's
# shared hosting.
#
# DATABASE_URL: Neon's POOLED connection string (has "-pooler" in the
# hostname) -- what the app actually queries through at runtime, via
# the adapter.
#
# DIRECT_URL: Neon's DIRECT/unpooled connection string (no "-pooler").
# IMPORTANT: `prisma migrate` always uses a raw TCP connection for
# schema operations, REGARDLESS of the driver adapter above -- that's
# a Prisma CLI limitation, not something this app's code can work
# around. This means migrations can NEVER be run from a host that
# blocks outbound Postgres TCP (like HostPinnacle) -- run
# `prisma migrate deploy` from your own machine, or from GitHub
# Actions, instead. See docs/DEPLOYMENT.md's HostPinnacle section.
#
# Get both from Neon's dashboard -- Connect -- and copy the exact
# strings shown there, they already include ?sslmode=require.
DATABASE_URL="postgresql://user:YOUR_PASSWORD@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:YOUR_PASSWORD@ep-example.region.aws.neon.tech/neondb?sslmode=require"

# ── Auth.js (required) ───────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Used in emails / absolute links generated server-side (invites, resets).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

NODE_ENV="development"

# ── AWS S3 (optional — falls back to local disk storage if unset) ─────
# See docs/INFRASTRUCTURE_SETUP.md for bucket + IAM setup.
AWS_REGION=""
AWS_S3_BUCKET=""
# Omit the two below entirely if deploying with an IAM role instead of keys.
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# ── Local file storage (only used if AWS_S3_BUCKET is unset) ──────────
# IMPORTANT if deploying to a host whose deploy pipeline wipes the app
# directory clean on every deploy (e.g. HostPinnacle, see
# docs/DEPLOYMENT.md): set this to an ABSOLUTE path OUTSIDE that
# directory, e.g. /home/architec/architect-hub-uploads, not a path
# inside /home/architec/architect-hub itself. Otherwise every future
# deploy permanently deletes every uploaded file. Leave unset for local
# dev (defaults to ./uploads inside the project).
LOCAL_UPLOAD_DIR=""

# ── Redis (optional — email/reminders silently no-op if unset) ────────
# Upstash TCP connection string (rediss://...), not the REST URL.
# See docs/INFRASTRUCTURE_SETUP.md.
REDIS_URL=""

# ── Resend (optional — required only for actual email delivery) ───────
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Architect Hub <notifications@yourdomain.com>"

# ── Cron secret (required only if using /api/cron/reminders) ──────────
# Needed on hosting that can't run a persistent worker process (e.g.
# shared hosting) -- an external cron service hits this URL on a
# schedule instead. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# See docs/DEPLOYMENT.md, "Shared hosting" section.
CRON_SECRET=""
