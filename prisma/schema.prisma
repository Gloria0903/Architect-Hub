generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String                  @id @default(cuid())
  name                String
  email               String                  @unique
  password            String
  role                Role                    @default(ARCHITECT)
  phone               String?
  department          String?
  initials            String
  mfaEnabled          Boolean                 @default(false)
  mfaSecret           String?
  joinDate            DateTime                @default(now())
  lastLoginAt         DateTime?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  isActive            Boolean                 @default(true)
  mustResetPassword   Boolean                 @default(false)
  failedLoginAttempts Int                     @default(0)
  lockedUntil         DateTime?
  passwordChangedAt   DateTime                @default(now())
  avatarKey           String?
  avatarUrl           String?
  activityLogs        ActivityLog[]
  fromAssignments     AssignmentRecord[]      @relation("FromArchitect")
  assignmentsMade     AssignmentRecord[]      @relation("PerformedByUser")
  toAssignments       AssignmentRecord[]      @relation("ToArchitect")
  dailyLogs           DailyLog[]
  documentsUploaded   Document[]              @relation("DocumentUploader")
  loginEvents         LoginEvent[]
  notifications       Notification[]
  passwordResetTokens PasswordResetToken[]
  payments            Payment[]
  assignedProjects    Project[]               @relation("ArchitectProjects")
  archivedProjects    Project[]               @relation("ArchivedProjects")
  restoredProjects    Project[]               @relation("RestoredProjects")
  supervisedProjects  Project[]               @relation("SupervisorProjects")
  lifecycleEvents     ProjectLifecycleEvent[] @relation("ProjectLifecycleEvents")

  @@index([email])
  @@index([role])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model LoginEvent {
  id        String   @id @default(cuid())
  success   Boolean
  ip        String?
  userAgent String?
  reason    String?
  createdAt DateTime @default(now())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
}

model Client {
  id                String          @id @default(cuid())
  name              String
  contactPerson     String
  email             String?
  phone             String?
  address           String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  lastPortalLoginAt DateTime?
  passwordHash      String?
  portalEnabled     Boolean         @default(false)
  comments          ClientComment[]
  projects          Project[]

  @@index([name])
  @@index([email])
}

model Project {
  id                String                  @id @default(cuid())
  sheetNo           String                  @unique
  name              String
  description       String?
  location          String
  status            ProjectStatus           @default(ON_TRACK)
  progress          Int                     @default(0)
  priority          Priority                @default(MEDIUM)
  startDate         DateTime
  dueDate           DateTime
  completionDate    DateTime?
  budget            Float                   @default(0)
  invoiced          Float                   @default(0)
  paid              Float                   @default(0)
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  clientId          String
  architectId       String?
  supervisorId      String?
  archivedAt        DateTime?
  archiveReason     String?
  archivedById      String?
  restoredAt        DateTime?
  restoredById      String?
  activityLogs      ActivityLog[]
  assignmentHistory AssignmentRecord[]
  comments          ClientComment[]
  dailyLogs         DailyLog[]
  documents         Document[]
  payments          Payment[]
  architect         User?                   @relation("ArchitectProjects", fields: [architectId], references: [id])
  archivedBy        User?                   @relation("ArchivedProjects", fields: [archivedById], references: [id])
  client            Client                  @relation(fields: [clientId], references: [id])
  restoredBy        User?                   @relation("RestoredProjects", fields: [restoredById], references: [id])
  supervisor        User?                   @relation("SupervisorProjects", fields: [supervisorId], references: [id])
  lifecycleEvents   ProjectLifecycleEvent[]

  @@index([status])
  @@index([architectId])
  @@index([supervisorId])
  @@index([clientId])
  @@index([sheetNo])
  @@index([archivedAt])
  @@index([archivedById])
  @@index([restoredById])
}

model ProjectLifecycleEvent {
  id            String                    @id @default(cuid())
  type          ProjectLifecycleEventType
  reason        String?
  createdAt     DateTime                  @default(now())
  projectId     String
  performedById String
  performedBy   User                      @relation("ProjectLifecycleEvents", fields: [performedById], references: [id])
  project       Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([performedById])
  @@index([type])
  @@index([createdAt])
}

model DailyLog {
  id            String   @id @default(cuid())
  date          DateTime
  workCompleted String
  challenges    String   @default("")
  pendingWork   String   @default("")
  nextActions   String   @default("")
  progress      Int
  submittedAt   DateTime @default(now())
  projectId     String
  authorId      String
  author        User     @relation(fields: [authorId], references: [id])
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, authorId, date])
  @@index([projectId])
  @@index([authorId])
  @@index([date])
}

model Document {
  id            String           @id @default(cuid())
  name          String
  fileKey       String
  fileUrl       String
  fileSize      Int
  mimeType      String
  version       Int              @default(1)
  uploadedAt    DateTime         @default(now())
  projectId     String
  uploadedById  String
  category      DocumentCategory @default(OTHER)
  isLatest      Boolean          @default(true)
  deletedAt     DateTime?
  parentId      String?
  clientVisible Boolean          @default(false)
  parent        Document?        @relation("DocumentVersions", fields: [parentId], references: [id], onDelete: Cascade)
  versions      Document[]       @relation("DocumentVersions")
  project       Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedBy    User             @relation("DocumentUploader", fields: [uploadedById], references: [id])

  @@index([projectId])
  @@index([projectId, isLatest])
  @@index([parentId])
}

model ClientComment {
  id         String      @id @default(cuid())
  content    String
  type       CommentType @default(FEEDBACK)
  author     String
  createdAt  DateTime    @default(now())
  resolvedAt DateTime?
  projectId  String
  clientId   String
  viaPortal  Boolean     @default(false)
  client     Client      @relation(fields: [clientId], references: [id])
  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([clientId])
  @@index([resolvedAt])
}

model Payment {
  id           String   @id @default(cuid())
  amount       Float
  date         DateTime
  reference    String?
  note         String?
  createdAt    DateTime @default(now())
  projectId    String
  recordedById String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  recordedBy   User     @relation(fields: [recordedById], references: [id])

  @@index([projectId])
}

model AssignmentRecord {
  id              String   @id @default(cuid())
  reason          String?
  date            DateTime @default(now())
  projectId       String
  fromArchitectId String?
  toArchitectId   String
  performedById   String
  fromArchitect   User?    @relation("FromArchitect", fields: [fromArchitectId], references: [id])
  performedBy     User     @relation("PerformedByUser", fields: [performedById], references: [id])
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  toArchitect     User     @relation("ToArchitect", fields: [toArchitectId], references: [id])

  @@index([projectId])
}

model FirmSettings {
  id        String   @id @default("singleton")
  firmName  String   @default("Architect Hub")
  updatedAt DateTime @updatedAt
}

model Notification {
  id        String           @id @default(cuid())
  message   String
  type      NotificationType @default(INFO)
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())
  userId    String
  dedupeKey String?
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, read])
}

model ActivityLog {
  id         String   @id @default(cuid())
  action     String
  entityType String
  entityId   String
  actorId    String
  projectId  String?
  metadata   Json?
  createdAt  DateTime @default(now())
  actor      User     @relation(fields: [actorId], references: [id])
  project    Project? @relation(fields: [projectId], references: [id])

  @@index([projectId])
  @@index([actorId])
  @@index([createdAt])
}

enum Role {
  ADMIN
  ARCHITECT
}

enum ProjectStatus {
  ON_TRACK
  AT_RISK
  DELAYED
  COMPLETED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum CommentType {
  FEEDBACK
  APPROVAL
  CHANGE_REQUEST
  QUERY
}

enum NotificationType {
  INFO
  WARNING
  SUCCESS
  ERROR
}

enum ProjectLifecycleEventType {
  ARCHIVED
  RESTORED
}

enum DocumentCategory {
  DRAWING
  BOQ
  CONTRACT
  SITE_REPORT
  PRESENTATION
  OTHER
}
